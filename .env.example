PORT=3333
DATABASE_URL=postgres://usuario:senha@localhost:5432/rpg_ficha
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# O limite de payload é fixado em 2mb no servidor.
JSON_BODY_LIMIT=2mb
JWT_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres

# E-mail (verificação de conta e redefinição de senha).
# Provedores suportados:
#   Resend (recomendado em produção) -> EMAIL_PROVIDER=resend + RESEND_API_KEY
#     1. Crie uma conta em https://resend.com e gere uma API Key (re_...).
#     2. EMAIL_PROVIDER=resend
#     3. RESEND_API_KEY=re_sua-chave-aqui
#     4. SMTP_FROM: remetente; no plano grátis use o domínio de testes do Resend (ex.: "Grimorium <onboarding@resend.dev>");
#        depois verifique seu domínio próprio no painel do Resend para enviar de qualquer endereço.
#   SMTP convencional -> EMAIL_PROVIDER=smtp (ou vazio) + SMTP_HOST/SMTP_* abaixo.
# Sem provedor configurado, o servidor apenas registra o link no log (modo dev) e,
# fora de produção, devolve o link/código na resposta para facilitar testes locais.
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Grimorium <onboarding@resend.dev>

# Exigir e-mail verificado para login (true/false; padrão: false).
REQUIRE_EMAIL_VERIFICATION=false

# Integração Google (Drive/Sheets/Docs) — opcional; sem elas as rotas /api/google/* respondem 501.
# Crie um projeto no Google Cloud Console, ative as APIs Drive v3, Sheets v4 e Docs v1,
# configure OAuth consent (escopos: drive.file, spreadsheets, documents) e um OAuth Client Web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/google/callback
# Chave AES-256-GCM (32 bytes em hex/base64) para criptografar tokens OAuth em repouso
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Opcional: tuning de segurança
# DB_SSL=true                 # força SSL mesmo fora de hosts supabase
# UPLOAD_MAX_BYTES=5242880    # tamanho máx. de upload (padrão 5 MB)
# UPLOAD_DIR=private_uploads  # pasta fora do público (modo local/legado)
# UPLOAD_READ_TTL_MS=900000   # validade das URLs de leitura assinadas (15 min)
# AUTH_RATE_LIMIT=5           # tentativas de login/min por IP
